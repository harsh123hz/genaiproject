# ── Demo works WITHOUT any key (mock LLM + local vector search) ──
# ── Add a key to enable real LLM calls (Groq is free & fast) ──

# Get free Groq key: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional: for Chat tab with Muse (also falls back to mock if missing)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
